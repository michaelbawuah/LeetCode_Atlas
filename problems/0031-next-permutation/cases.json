[
  {
    "name": "ascending input",
    "args": [
      [
        1,
        2,
        3
      ]
    ],
    "expected": [
      1,
      3,
      2
    ]
  },
  {
    "name": "wrap from last permutation",
    "args": [
      [
        3,
        2,
        1
      ]
    ],
    "expected": [
      1,
      2,
      3
    ]
  },
  {
    "name": "duplicate values",
    "args": [
      [
        1,
        1,
        5
      ]
    ],
    "expected": [
      1,
      5,
      1
    ]
  },
  {
    "name": "singleton",
    "args": [
      [
        1
      ]
    ],
    "expected": [
      1
    ]
  },
  {
    "name": "pivot near front",
    "args": [
      [
        1,
        3,
        2
      ]
    ],
    "expected": [
      2,
      1,
      3
    ]
  },
  {
    "name": "repeated successor values",
    "args": [
      [
        2,
        3,
        1,
        3,
        3
      ]
    ],
    "expected": [
      2,
      3,
      3,
      1,
      3
    ]
  }
]
