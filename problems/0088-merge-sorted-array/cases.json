[
  {
    "name": "overlapping sorted inputs",
    "args": [
      [
        1,
        2,
        3,
        0,
        0,
        0
      ],
      3,
      [
        2,
        5,
        6
      ],
      3
    ],
    "expected": [
      1,
      2,
      2,
      3,
      5,
      6
    ]
  },
  {
    "name": "second input empty",
    "args": [
      [
        1
      ],
      1,
      [],
      0
    ],
    "expected": [
      1
    ]
  },
  {
    "name": "first logical input empty",
    "args": [
      [
        0
      ],
      0,
      [
        1
      ],
      1
    ],
    "expected": [
      1
    ]
  },
  {
    "name": "second starts smaller",
    "args": [
      [
        2,
        0
      ],
      1,
      [
        1
      ],
      1
    ],
    "expected": [
      1,
      2
    ]
  },
  {
    "name": "signed values",
    "args": [
      [
        -3,
        -1,
        0,
        0
      ],
      2,
      [
        -2,
        4
      ],
      2
    ],
    "expected": [
      -3,
      -2,
      -1,
      4
    ]
  },
  {
    "name": "real zeroes and placeholders",
    "args": [
      [
        0,
        0,
        0
      ],
      0,
      [
        0,
        0,
        0
      ],
      3
    ],
    "expected": [
      0,
      0,
      0
    ]
  },
  {
    "name": "large signed values",
    "args": [
      [
        -1000000000,
        0
      ],
      1,
      [
        1000000000
      ],
      1
    ],
    "expected": [
      -1000000000,
      1000000000
    ]
  }
]
