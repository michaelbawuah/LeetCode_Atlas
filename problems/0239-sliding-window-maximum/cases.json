[
  {
    "name": "mixed peaks",
    "args": [
      [
        1,
        3,
        -1,
        -3,
        5,
        3,
        6,
        7
      ],
      3
    ],
    "expected": [
      3,
      3,
      5,
      5,
      6,
      7
    ]
  },
  {
    "name": "singleton",
    "args": [
      [
        1
      ],
      1
    ],
    "expected": [
      1
    ]
  },
  {
    "name": "unit windows",
    "args": [
      [
        2,
        1,
        3
      ],
      1
    ],
    "expected": [
      2,
      1,
      3
    ]
  },
  {
    "name": "whole array window",
    "args": [
      [
        2,
        1,
        3
      ],
      3
    ],
    "expected": [
      3
    ]
  },
  {
    "name": "equal values expire",
    "args": [
      [
        4,
        4,
        4,
        1
      ],
      2
    ],
    "expected": [
      4,
      4,
      4
    ]
  },
  {
    "name": "all negative",
    "args": [
      [
        -4,
        -2,
        -5
      ],
      2
    ],
    "expected": [
      -2,
      -2
    ]
  },
  {
    "name": "increasing values",
    "args": [
      [
        1,
        2,
        3,
        4
      ],
      2
    ],
    "expected": [
      2,
      3,
      4
    ]
  },
  {
    "name": "decreasing values",
    "args": [
      [
        4,
        3,
        2,
        1
      ],
      2
    ],
    "expected": [
      4,
      3,
      2
    ]
  }
]
