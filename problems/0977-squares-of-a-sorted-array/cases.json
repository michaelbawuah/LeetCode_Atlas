[
  {
    "name": "mixed signs",
    "args": [
      [
        -4,
        -1,
        0,
        3,
        10
      ]
    ],
    "expected": [
      0,
      1,
      9,
      16,
      100
    ]
  },
  {
    "name": "equal absolute values",
    "args": [
      [
        -7,
        -3,
        2,
        3,
        11
      ]
    ],
    "expected": [
      4,
      9,
      9,
      49,
      121
    ]
  },
  {
    "name": "singleton zero",
    "args": [
      [
        0
      ]
    ],
    "expected": [
      0
    ]
  },
  {
    "name": "all negative",
    "args": [
      [
        -3,
        -2,
        -1
      ]
    ],
    "expected": [
      1,
      4,
      9
    ]
  },
  {
    "name": "all positive",
    "args": [
      [
        1,
        2,
        3
      ]
    ],
    "expected": [
      1,
      4,
      9
    ]
  },
  {
    "name": "repeated magnitudes",
    "args": [
      [
        -2,
        -2,
        2
      ]
    ],
    "expected": [
      4,
      4,
      4
    ]
  },
  {
    "name": "squared integer bounds",
    "args": [
      [
        -10000,
        10000
      ]
    ],
    "expected": [
      100000000,
      100000000
    ]
  }
]
