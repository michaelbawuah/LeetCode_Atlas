[
  {
    "name": "all colors interleaved",
    "args": [
      [
        2,
        0,
        2,
        1,
        1,
        0
      ]
    ],
    "expected": [
      0,
      0,
      1,
      1,
      2,
      2
    ]
  },
  {
    "name": "one of each",
    "args": [
      [
        2,
        0,
        1
      ]
    ],
    "expected": [
      0,
      1,
      2
    ]
  },
  {
    "name": "singleton zero",
    "args": [
      [
        0
      ]
    ],
    "expected": [
      0
    ]
  },
  {
    "name": "all twos",
    "args": [
      [
        2,
        2,
        2
      ]
    ],
    "expected": [
      2,
      2,
      2
    ]
  },
  {
    "name": "already ordered",
    "args": [
      [
        0,
        1,
        2
      ]
    ],
    "expected": [
      0,
      1,
      2
    ]
  },
  {
    "name": "swapped incoming zeros",
    "args": [
      [
        2,
        2,
        0,
        0
      ]
    ],
    "expected": [
      0,
      0,
      2,
      2
    ]
  }
]
