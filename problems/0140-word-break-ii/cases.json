      [
        "apple",
        "pen",
        "applepen",
        "pine",
        "pineapple"
      ]
    ],
    "expected": [
      "pine apple pen apple",
      "pineapple pen apple",
      "pine applepen apple"
    ]
  },
  {
    "name": "impossible_suffix",
    "args": [
