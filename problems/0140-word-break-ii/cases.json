        "b"
      ]
    ],
    "expected": []
  },
  {
    "name": "two_prefix_choices",
    "args": [
      "abcd",
      [
        "ab",
        "cd",
        "a",
        "bcd"
      ]
    ],
    "expected": [
      "ab cd",
      "a bcd"
    ]
  },
  {
    "name": "repeated_only_word",
    "args": [
      "aaaa",
      [
