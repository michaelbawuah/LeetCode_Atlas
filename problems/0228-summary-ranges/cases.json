[
  {
    "name": "several ranges",
    "args": [
      [
        0,
        1,
        2,
        4,
        5,
        7
      ]
    ],
    "expected": [
      "0->2",
      "4->5",
      "7"
    ]
  },
  {
    "name": "singleton gaps",
    "args": [
      [
        0,
        2,
        3,
        4,
        6,
        8,
        9
      ]
    ],
    "expected": [
      "0",
      "2->4",
      "6",
      "8->9"
    ]
  },
  {
    "name": "empty input",
    "args": [
      []
    ],
    "expected": []
  },
  {
    "name": "singleton",
    "args": [
      [
        5
      ]
    ],
    "expected": [
      "5"
    ]
  },
  {
    "name": "negative range",
    "args": [
      [
        -3,
        -2,
        -1,
        1
      ]
    ],
    "expected": [
      "-3->-1",
      "1"
    ]
  },
  {
    "name": "integer endpoints",
    "args": [
      [
        -2147483648,
        -2147483647,
        2147483647
      ]
    ],
    "expected": [
      "-2147483648->-2147483647",
      "2147483647"
    ]
  }
]
