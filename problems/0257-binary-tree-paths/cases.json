[
  {
    "name": "two_paths",
    "args": [
      [
        1,
        2,
        3,
        null,
        5
      ]
    ],
    "expected": [
      "1->2->5",
      "1->3"
    ]
  },
  {
    "name": "singleton",
    "args": [
      [
        1
      ]
    ],
    "expected": [
      "1"
    ]
  },
  {
    "name": "negative",
    "args": [
      [
        0,
        -1,
        2
      ]
    ],
    "expected": [
      "0->-1",
      "0->2"
    ]
  },
  {
    "name": "one_chain",
    "args": [
      [
        1,
        null,
        2,
        null,
        3
      ]
    ],
    "expected": [
      "1->2->3"
    ]
  },
  {
    "name": "duplicate_paths",
    "args": [
      [
        1,
        1,
        1
      ]
    ],
    "expected": [
      "1->1",
      "1->1"
    ]
  },
  {
    "name": "sparse",
    "args": [
      [
        4,
        2,
        null,
        null,
        3
      ]
    ],
    "expected": [
      "4->2->3"
    ]
  }
]
