[
  {
    "name": "interleaved zeros",
    "args": [
      [
        0,
        1,
        0,
        3,
        12
      ]
    ],
    "expected": [
      1,
      3,
      12,
      0,
      0
    ]
  },
  {
    "name": "single zero",
    "args": [
      [
        0
      ]
    ],
    "expected": [
      0
    ]
  },
  {
    "name": "no zeros",
    "args": [
      [
        1,
        2,
        3
      ]
    ],
    "expected": [
      1,
      2,
      3
    ]
  },
  {
    "name": "all zeros",
    "args": [
      [
        0,
        0,
        0
      ]
    ],
    "expected": [
      0,
      0,
      0
    ]
  },
  {
    "name": "leading zeros",
    "args": [
      [
        0,
        0,
        1,
        2
      ]
    ],
    "expected": [
      1,
      2,
      0,
      0
    ]
  },
  {
    "name": "trailing zeros",
    "args": [
      [
        1,
        2,
        0,
        0
      ]
    ],
    "expected": [
      1,
      2,
      0,
      0
    ]
  },
  {
    "name": "signed nonzero order",
    "args": [
      [
        0,
        -1,
        0,
        2,
        -3
      ]
    ],
    "expected": [
      -1,
      2,
      -3,
      0,
      0
    ]
  },
  {
    "name": "integer boundaries",
    "args": [
      [
        -2147483648,
        0,
        2147483647
      ]
    ],
    "expected": [
      -2147483648,
      2147483647,
      0
    ]
  }
]
