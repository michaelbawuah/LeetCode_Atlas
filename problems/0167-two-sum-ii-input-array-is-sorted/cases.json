[
  {
    "name": "sorted example",
    "args": [
      [
        2,
        7,
        11,
        15
      ],
      9
    ],
    "expected": [
      1,
      2
    ]
  },
  {
    "name": "discard right endpoint",
    "args": [
      [
        2,
        3,
        4
      ],
      6
    ],
    "expected": [
      1,
      3
    ]
  },
  {
    "name": "negative pair",
    "args": [
      [
        -1,
        0
      ],
      -1
    ],
    "expected": [
      1,
      2
    ]
  },
  {
    "name": "equal values",
    "args": [
      [
        3,
        3
      ],
      6
    ],
    "expected": [
      1,
      2
    ]
  },
  {
    "name": "pair in middle",
    "args": [
      [
        1,
        2,
        3,
        4,
        9
      ],
      6
    ],
    "expected": [
      2,
      4
    ]
  },
  {
    "name": "both pointers must move",
    "args": [
      [
        -5,
        -3,
        0,
        2,
        4,
        8
      ],
      1
    ],
    "expected": [
      2,
      5
    ]
  },
  {
    "name": "two zeroes",
    "args": [
      [
        0,
        0
      ],
      0
    ],
    "expected": [
      1,
      2
    ]
  }
]
